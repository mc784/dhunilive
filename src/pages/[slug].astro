---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const releases = await getCollection('releases');
  return releases
    .filter(release => !release.data.draft)
    .map(release => ({
      params: { slug: release.slug },
      props: { release },
    }));
}

const { release } = Astro.props;
const { Content } = await release.render();
const data = release.data;

// JSON-LD for MusicRecording
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicRecording',
  name: data.title_hi,
  alternateName: data.title_roman,
  byArtist: {
    '@type': 'MusicGroup',
    name: 'Dhuni',
    alternateName: 'धूनी',
  },
  inAlbum: {
    '@type': 'MusicAlbum',
    name: 'Dhuni Singles',
  },
  genre: 'Bhajan',
  inLanguage: 'hi',
  datePublished: data.release_date.toISOString(),
  url: `https://dhunilive.com/${release.slug}`,
  ...(data.youtube_id && {
    sameAs: [`https://youtube.com/watch?v=${data.youtube_id}`],
  }),
};

const title = `${data.title_hi} — ${data.title_roman} | Dhuni`;
const description = `${data.deity} bhajan in ${data.dialect} dialect. Singer: ${data.credits.singer}. ${data.rights_status === 'traditional' ? 'Traditional composition' : 'Original composition'}.`;
---

<Base title={title} description={description} jsonLd={jsonLd}>

  <main>
    <div class="container">

      <!-- Release Header -->
      <header class="release-header">
        <h1 class="release-detail-title" lang="hi">{data.title_hi}</h1>
        <p class="release-title-roman" lang="en">{data.title_roman}</p>

        <!-- Metadata -->
        <div class="release-metadata">
          <div class="metadata-grid">
            <div class="metadata-item">
              <span class="metadata-label" lang="en">Deity</span>
              <span class="metadata-value" lang="en">{data.deity} — {data.deity_form}</span>
            </div>
            <div class="metadata-item">
              <span class="metadata-label" lang="en">Dialect</span>
              <span class="metadata-value" lang="en">{data.dialect}</span>
            </div>
            {data.raga && (
              <div class="metadata-item">
                <span class="metadata-label" lang="en">Raga</span>
                <span class="metadata-value" lang="en">{data.raga}</span>
              </div>
            )}
            {data.taal && (
              <div class="metadata-item">
                <span class="metadata-label" lang="en">Taal</span>
                <span class="metadata-value" lang="en">{data.taal}</span>
              </div>
            )}
            {data.bpm && (
              <div class="metadata-item">
                <span class="metadata-label" lang="en">Tempo</span>
                <span class="metadata-value" lang="en">{data.bpm} BPM</span>
              </div>
            )}
            <div class="metadata-item">
              <span class="metadata-label" lang="en">Year</span>
              <span class="metadata-value" lang="en">{data.year}</span>
            </div>
          </div>
        </div>
      </header>

      <!-- YouTube Thumbnail Link (lite embed, no iframe) -->
      {data.youtube_id && (
        <a
          href={`https://youtube.com/watch?v=${data.youtube_id}`}
          class="youtube-thumbnail"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Watch on YouTube"
        >
          <img
            src={`https://i.ytimg.com/vi/${data.youtube_id}/maxresdefault.jpg`}
            alt={`${data.title_roman} on YouTube`}
            width="1280"
            height="720"
            loading="lazy"
          />
        </a>
      )}

      <!-- Streaming Links -->
      {(data.spotify_url || data.jiosaavn_url || data.apple_url) && (
        <div class="streaming-links">
          {data.spotify_url && (
            <a href={data.spotify_url} class="streaming-link" target="_blank" rel="noopener noreferrer" lang="en">
              Spotify
            </a>
          )}
          {data.jiosaavn_url && (
            <a href={data.jiosaavn_url} class="streaming-link" target="_blank" rel="noopener noreferrer" lang="en">
              JioSaavn
            </a>
          )}
          {data.apple_url && (
            <a href={data.apple_url} class="streaming-link" target="_blank" rel="noopener noreferrer" lang="en">
              Apple Music
            </a>
          )}
        </div>
      )}

      <!-- Credits -->
      <div class="credits">
        <h3 lang="en">Credits</h3>
        <ul class="credits-list">
          <li><strong lang="en">Singer:</strong> <span lang="en">{data.credits.singer}</span></li>
          {data.credits.lyrics && (
            <li><strong lang="en">Lyrics:</strong> <span lang="en">{data.credits.lyrics}</span></li>
          )}
          {data.credits.music && (
            <li><strong lang="en">Music:</strong> <span lang="en">{data.credits.music}</span></li>
          )}
          {data.credits.chorus && (
            <li><strong lang="en">Chorus:</strong> <span lang="en">{data.credits.chorus}</span></li>
          )}
        </ul>
      </div>

      <!-- Rights Attribution (if not original) -->
      {data.rights_status !== 'original' && data.rights_note && (
        <div class="rights-note">
          <strong lang="en">Rights:</strong> <span lang="en">{data.rights_note}</span>
        </div>
      )}

      <!-- Lyrics (server-rendered HTML from markdown) -->
      <div class="lyrics-section">
        <Content />
      </div>

      <!-- Back Link -->
      <p style="margin-top: 3rem; text-align: center;">
        <a href="/" lang="en">← Back to all releases</a>
      </p>

    </div>
  </main>

</Base>
