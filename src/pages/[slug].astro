---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const releases = await getCollection('releases');
  return releases
    .filter(release => !release.data.draft)
    .map(release => ({
      params: { slug: release.slug },
      props: { release },
    }));
}

const { release } = Astro.props;
const { Content } = await release.render();
const data = release.data;

// JSON-LD for MusicRecording
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicRecording',
  name: data.title_hi,
  alternateName: data.title_roman,
  byArtist: {
    '@type': 'MusicGroup',
    name: 'Dhuni Live',
    alternateName: 'धूनी लाइव',
  },
  inAlbum: {
    '@type': 'MusicAlbum',
    name: 'Dhuni Sacred Classics',
  },
  genre: 'Bhajan / Vedic Chant',
  inLanguage: data.dialect,
  datePublished: data.release_date.toISOString(),
  url: `https://dhunilive.com/${release.slug}`,
  ...(data.youtube_id && {
    sameAs: [`https://youtube.com/watch?v=${data.youtube_id}`],
  }),
};

const title = `${data.title_hi} — ${data.title_roman} | Dhuni Live`;
const description = `${data.deity} bhajan & shloka in ${data.dialect}. Singer: ${data.credits.singer}. Traditional Indian devotional acoustics.`;

const posterImg = data.hero_image || data.cover_image || `https://i.ytimg.com/vi/${data.youtube_id}/maxresdefault.jpg`;
const has16x9 = Boolean(data.youtube_16x9_id);
const has9x16 = Boolean(data.youtube_short_id || (!has16x9 && data.youtube_id));
const hasBothFormats = has16x9 && has9x16;
---

<Base title={title} description={description} jsonLd={jsonLd}>

  <!-- Top Navigation Bar -->
  <nav class="site-nav">
    <div class="container-wide site-nav-inner">
      <a href="/" class="brand-badge">
        <img src="/media/dhuni_logo.png" alt="Dhuni Live Emblem" class="brand-emblem" />
        <div class="brand-text">
          <span class="brand-title-hi">धूनी</span>
          <span class="brand-title-en">Dhuni Live</span>
        </div>
      </a>

      <ul class="nav-links">
        <li><a href="/#releases" data-i18n-hi="← सभी प्रस्तुतियाँ (All Releases)" data-i18n-en="← All Releases">← सभी प्रस्तुतियाँ (All Releases)</a></li>
        <li><a href="https://youtube.com/@DhuniLive" target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a href="https://instagram.com/dhunilive.official" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li>
          <div class="lang-switch-pill" id="langSwitch">
            <button class="lang-btn active" id="btnLangHi" onclick="window.setLanguage('hi')">हिन्दी</button>
            <span class="lang-divider">|</span>
            <button class="lang-btn" id="btnLangEn" onclick="window.setLanguage('en')">EN</button>
          </div>
        </li>
      </ul>
    </div>
  </nav>

  <main>
    <div class="container">

      <!-- Release Header -->
      <header class="release-detail-header">
        <span class="detail-deity-pill">
          {data.deity} {data.deity_form ? `• ${data.deity_form}` : ''}
        </span>
        
        <h1 class="detail-title-hi" lang="hi" id="detailTitle" data-i18n-hi={data.title_hi} data-i18n-en={data.title_roman}>{data.title_hi}</h1>
        <p class="detail-title-en" lang="en" id="detailSub" data-i18n-hi={data.title_roman} data-i18n-en={data.title_hi}>{data.title_roman}</p>
      </header>

      <!-- Dual-Format Switcher or Single Format Status Indicator -->
      {hasBothFormats && (
        <div class="format-toggle-bar">
          <button
            id="btn16x9"
            class="format-btn active"
            onclick="window.switchFormat('16x9')"
          >
            <span>📺</span>
            <span data-i18n-hi="16:9 ध्यान जप (Widescreen Chanting)" data-i18n-en="16:9 Meditative Chanting">16:9 ध्यान जप (Widescreen Chanting)</span>
          </button>

          <button
            id="btn9x16"
            class="format-btn"
            onclick="window.switchFormat('9x16')"
          >
            <span>📱</span>
            <span data-i18n-hi="9:16 लघु दर्शन (Shorts & Reels)" data-i18n-en="9:16 Vertical Short (Shorts & Reels)">9:16 लघु दर्शन (Shorts & Reels)</span>
          </button>
        </div>
      )}

      {has9x16 && !has16x9 && (
        <div class="format-status-badge">
          <span class="badge-active" data-i18n-hi="📱 लघु दर्शन (Vertical Short)" data-i18n-en="📱 9:16 Vertical Short">📱 लघु दर्शन (Vertical Short)</span>
          <span class="badge-upcoming" data-i18n-hi="📺 16:9 ध्यान जप: संपादन जारी • Coming Soon" data-i18n-en="📺 16:9 Widescreen Chanting: In Production • Coming Soon">📺 16:9 ध्यान जप: संपादन जारी • Coming Soon</span>
        </div>
      )}

      {has16x9 && !has9x16 && (
        <div class="format-status-badge">
          <span class="badge-active" data-i18n-hi="📺 ध्यान जप (16:9 Widescreen)" data-i18n-en="📺 16:9 Meditative Chanting">📺 ध्यान जप (16:9 Widescreen)</span>
        </div>
      )}

      <!-- Format-Aware Media Stage -->
      <div id="stageWrapper">
        <!-- 16:9 Viewport (if available) -->
        {has16x9 && (
          <div class="video-stage-16x9" id="view16x9">
            <div
              class="lite-embed-facade"
              id="facade16x9"
              style={`background-image: url('${posterImg}');`}
              onclick={`window.loadEmbed('view16x9', '${data.youtube_16x9_id}')`}
            >
              <div class="play-button-gold" title="Play 16:9 Chanting Video">
                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
        )}

        <!-- 9:16 Vertical Phone Viewport (if available) -->
        {has9x16 && (
          <div
            class="video-stage-9x16"
            id="view9x16"
            style={hasBothFormats ? 'display: none;' : 'display: block;'}
          >
            <div
              class="lite-embed-facade"
              id="facade9x16"
              style={`background-image: url('${data.cover_image || posterImg}');`}
              onclick={`window.loadEmbed('view9x16', '${data.youtube_short_id || data.youtube_id}')`}
            >
              <div class="play-button-gold" title="Play 9:16 Vertical Short">
                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Dedicated Dhyana Audio Player (Listen while Chanting) -->
      {data.audio_url && (
        <div class="dhyana-audio-card">
          <div class="dhyana-audio-info">
            <span class="dhyana-icon">🕉️</span>
            <div>
              <div class="dhyana-title" lang="hi" data-i18n-hi="सात्त्विक श्रवण एवं जप (Dhyana Audio)" data-i18n-en="Sattvic Audio & Chanting Loop">सात्त्विक श्रवण एवं जप (Dhyana Audio)</div>
              <div class="dhyana-sub" data-i18n-hi="मास्टरिंग: -14 LUFS • अखंड जप एवं पूजा हेतु स्वतः लूप" data-i18n-en="Mastered at -14 LUFS • Continuous loop enabled for daily prayer">Mastered at -14 LUFS • Loop enabled for continuous prayer</div>
            </div>
          </div>

          <audio
            controls
            loop
            src={data.audio_url}
            class="audio-element"
            preload="metadata"
          >
            Your browser does not support the audio element.
          </audio>
        </div>
      )}

      <!-- Metadata Grid (Raag, Taal & BPM removed) -->
      <div class="metadata-card-grid">
        <div>
          <div class="metadata-box-label" data-i18n-hi="आराध्य" data-i18n-en="Deity">आराध्य • Deity</div>
          <div class="metadata-box-val">{data.deity}</div>
        </div>

        <div>
          <div class="metadata-box-label" data-i18n-hi="भाषा" data-i18n-en="Language / Dialect">भाषा • Dialect</div>
          <div class="metadata-box-val">{data.dialect}</div>
        </div>

        {data.category && (
          <div>
            <div class="metadata-box-label" data-i18n-hi="विधा" data-i18n-en="Genre">विधा • Category</div>
            <div class="metadata-box-val">{data.category}</div>
          </div>
        )}

        <div>
          <div class="metadata-box-label" data-i18n-hi="स्वर" data-i18n-en="Voice / Singer">स्वर • Singer</div>
          <div class="metadata-box-val">{data.credits.singer}</div>
        </div>
      </div>

      <!-- Sacred Lyrics, Meaning & Shloka Section -->
      <div class="lyrics-container">
        <Content />
      </div>

      <!-- Rights & Spiritual Attribution -->
      {data.rights_note && (
        <div class="rights-note">
          <strong lang="en" data-i18n-hi="अधिकार एवं श्रेय:" data-i18n-en="Rights & Attribution:">Rights & Attribution:</strong> {data.rights_note}
        </div>
      )}

      <!-- Back Link & Social Share -->
      <div style="margin: 3.5rem 0 2rem; text-align: center; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/" class="btn-subtle" data-i18n-hi="← सभी प्रस्तुतियाँ (Catalog)" data-i18n-en="← All Releases">
          <span data-i18n-hi="← सभी प्रस्तुतियाँ (Catalog)" data-i18n-en="← All Releases">← सभी प्रस्तुतियाँ (Catalog)</span>
        </a>
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`॥ ${data.title_hi} ॥\nhttps://dhunilive.com/${release.slug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
          data-i18n-hi="💬 WhatsApp पर साझा करें"
          data-i18n-en="💬 Share on WhatsApp"
        >
          <span data-i18n-hi="💬 WhatsApp पर साझा करें" data-i18n-en="💬 Share on WhatsApp">💬 WhatsApp पर साझा करें</span>
        </a>
        <a
          href="https://whatsapp.com/channel/0029VbDdbaFIN9iua995UG3n"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-subtle"
          data-i18n-hi="🌿 WhatsApp चैनल"
          data-i18n-en="🌿 WhatsApp Channel"
        >
          <span data-i18n-hi="🌿 WhatsApp चैनल" data-i18n-en="🌿 WhatsApp Channel">🌿 WhatsApp चैनल</span>
        </a>
      </div>

    </div>
  </main>

  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <p class="footer-creed" lang="hi" data-i18n-hi="धूनी — शाश्वत स्वर • सांस्कृतिक चेतना • समसामयिक दृष्टि" data-i18n-en="Dhuni — Sacred Acoustics • Cultural Narratives • Civilizational Discourse">
        धूनी — शाश्वत स्वर • सांस्कृतिक चेतना • समसामयिक दृष्टि
      </p>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; max-width: 680px; margin-left: auto; margin-right: auto;" data-i18n-hi="वैदिक मंत्रों और शास्त्रीय ध्वनियों से लेकर, भारत के समृद्ध इतिहास, सांस्कृतिक वृत्तचित्रों और समसामयिक विषयों के गहन विश्लेषण तक — एक मौलिक, सात्त्विक भारतीय मंच।" data-i18n-en="From sacred Vedic chants and acoustic Indian melodies to deep cultural documentaries and insightful civilizational perspectives on contemporary affairs — an authentic, sattvic Indian platform.">
        वैदिक मंत्रों और शास्त्रीय ध्वनियों से लेकर, भारत के समृद्ध इतिहास, सांस्कृतिक वृत्तचित्रों और समसामयिक विषयों के गहन विश्लेषण तक — एक मौलिक, सात्त्विक भारतीय मंच।
      </p>

      <ul class="footer-nav">
        <li><a href="/#releases" data-i18n-hi="प्रस्तुतियाँ (Catalog)" data-i18n-en="Offerings (Catalog)">प्रस्तुतियाँ (Catalog)</a></li>
        <li><a href="https://whatsapp.com/channel/0029VbDdbaFIN9iua995UG3n" target="_blank" rel="noopener noreferrer" data-i18n-hi="WhatsApp चैनल" data-i18n-en="WhatsApp Channel">WhatsApp चैनल</a></li>
        <li><a href="https://youtube.com/@DhuniLive" target="_blank" rel="noopener noreferrer" data-i18n-hi="YouTube" data-i18n-en="YouTube">YouTube</a></li>
        <li><a href="https://instagram.com/dhunilive.official" target="_blank" rel="noopener noreferrer" data-i18n-hi="Instagram" data-i18n-en="Instagram">Instagram</a></li>
        <li><a href="mailto:hello@dhunilive.com" data-i18n-hi="संपर्क (Email)" data-i18n-en="Contact (Email)">Email / संपर्क</a></li>
      </ul>

      <p style="font-size: 0.8rem; color: #665f57;" data-i18n-hi={`© ${new Date().getFullYear()} धूनी लाइव। सर्वाधिकार सुरक्षित। मौलिक भारतीय सांस्कृतिक एवं ध्वन्यात्मक मंच।`} data-i18n-en={`© ${new Date().getFullYear()} Dhuni Live. All rights reserved. Authentic Indian Cultural & Acoustic Media.`}>
        © {new Date().getFullYear()} Dhuni Live. All rights reserved. Authentic Indian Cultural & Acoustic Media.
      </p>
    </div>
  </footer>

  <!-- Dynamic Format Switcher Script with Auto Mobile Detection & Language Switcher -->
  <script is:inline>
    window.switchFormat = function switchFormat(format) {
      const btn16 = document.getElementById('btn16x9');
      const btn9 = document.getElementById('btn9x16');
      const view16 = document.getElementById('view16x9');
      const view9 = document.getElementById('view9x16');

      if (format === '16x9') {
        if (btn16) btn16.classList.add('active');
        if (btn9) btn9.classList.remove('active');
        if (view16) view16.style.display = 'block';
        if (view9) view9.style.display = 'none';
      } else {
        if (btn9) btn9.classList.add('active');
        if (btn16) btn16.classList.remove('active');
        if (view16) view16.style.display = 'none';
        if (view9) view9.style.display = 'block';
      }
    };

    window.loadEmbed = function loadEmbed(containerId, videoId) {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.innerHTML = `
        <iframe
          src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1"
          title="Dhuni Live Video"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          style="width: 100%; height: 100%; border: none; position: absolute; top:0; left:0;"
        ></iframe>
      `;
    };

    // Auto-detect viewport on load: only toggle if both formats exist
    function initDetailFormat() {
      const view16 = document.getElementById('view16x9');
      const view9 = document.getElementById('view9x16');
      if (view16 && view9) {
        const isMobile = window.innerWidth <= 768;
        window.switchFormat(isMobile ? '9x16' : '16x9');
      } else if (view9) {
        view9.style.display = 'block';
      } else if (view16) {
        view16.style.display = 'block';
      }
    }

    // Discrete Language Switcher
    window.setLanguage = function setLanguage(lang) {
      const btnHi = document.getElementById('btnLangHi');
      const btnEn = document.getElementById('btnLangEn');
      if (lang === 'en') {
        if (btnEn) btnEn.classList.add('active');
        if (btnHi) btnHi.classList.remove('active');
        document.documentElement.lang = 'en';
      } else {
        if (btnHi) btnHi.classList.add('active');
        if (btnEn) btnEn.classList.remove('active');
        document.documentElement.lang = 'hi';
      }
      try {
        localStorage.setItem('dhuni_lang', lang);
      } catch (e) {}

      document.querySelectorAll('[data-i18n-hi]').forEach(el => {
        const text = lang === 'en' ? el.getAttribute('data-i18n-en') : el.getAttribute('data-i18n-hi');
        if (text) {
          el.textContent = text;
        }
      });
    };

    function initLanguage() {
      try {
        const saved = localStorage.getItem('dhuni_lang') || 'hi';
        window.setLanguage(saved);
      } catch (e) {}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initDetailFormat();
        initLanguage();
      });
    } else {
      initDetailFormat();
      initLanguage();
    }
  </script>

</Base>
