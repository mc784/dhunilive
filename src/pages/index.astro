---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Get all non-draft releases, sorted by date descending
const releases = (await getCollection('releases'))
  .filter(release => !release.data.draft)
  .sort((a, b) => b.data.release_date.getTime() - a.data.release_date.getTime());

const featuredRelease = releases.find(r => r.data.featured) || releases[0];
const featuredHas16x9 = Boolean(featuredRelease?.data.youtube_16x9_id);
const featuredHas9x16 = Boolean(featuredRelease?.data.youtube_short_id || (!featuredHas16x9 && featuredRelease?.data.youtube_id));
const featuredHasBoth = featuredHas16x9 && featuredHas9x16;

// JSON-LD for MusicGroup
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Dhuni Live',
  alternateName: 'धूनी लाइव',
  genre: 'Indian Classical / Devotional / Bhajan',
  url: 'https://dhunilive.com',
  sameAs: [
    'https://youtube.com/@DhuniLive',
    'https://instagram.com/dhunilive.official',
  ],
  description: 'Sacred Sanskrit shlokas, stutis, and traditional Indian devotional acoustics presented with sattvic reverence and world-class fidelity.',
};

const title = 'धूनी • Dhuni Live — शाश्वत स्वर, सांस्कृतिक चेतना एवं समसामयिक दृष्टि';
const description = 'वैदिक ऋचाओं और शास्त्रीय संगीत से लेकर, भारत के समृद्ध इतिहास, सांस्कृतिक वृत्तचित्रों और समसामयिक विषयों के गहन विश्लेषण तक — धूनी लाइव।';
---

<Base title={title} description={description} jsonLd={jsonLd}>

  <!-- Top Navigation Bar -->
  <nav class="site-nav">
    <div class="container-wide site-nav-inner">
      <a href="/" class="brand-badge">
        <img src="/media/dhuni_logo.png" alt="Dhuni Live Emblem" class="brand-emblem" />
        <div class="brand-text">
          <span class="brand-title-hi">धूनी</span>
          <span class="brand-title-en">Dhuni Live</span>
        </div>
      </a>

      <ul class="nav-links">
        <li><a href="#releases" data-i18n-hi="प्रस्तुतियाँ (Catalog)" data-i18n-en="Releases">प्रस्तुतियाँ (Catalog)</a></li>
        <li><a href="https://youtube.com/@DhuniLive" target="_blank" rel="noopener noreferrer" data-i18n-hi="यूट्यूब" data-i18n-en="YouTube">यूट्यूब</a></li>
        <li><a href="https://instagram.com/dhunilive.official" target="_blank" rel="noopener noreferrer" data-i18n-hi="इंस्टाग्राम" data-i18n-en="Instagram">इंस्टाग्राम</a></li>
        <li>
          <a href="#community" class="nav-cta-btn">
            <span>🌿</span>
            <span data-i18n-hi="व्हाट्सएप चैनल" data-i18n-en="WhatsApp Channel">व्हाट्सएप चैनल</span>
          </a>
        </li>
        <li>
          <div class="lang-switch-pill" id="langSwitch">
            <button class="lang-btn active" id="btnLangHi" onclick="window.setLanguage('hi')">हिन्दी</button>
            <span class="lang-divider">|</span>
            <button class="lang-btn" id="btnLangEn" onclick="window.setLanguage('en')">EN</button>
          </div>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Hero Theater (Featured Offering with Responsive Dual-Format Support) -->
  {featuredRelease && (
    <section class="hero-theater">
      <div class="container-wide">
        <div class="hero-card">
          <div class="hero-grid">

            <!-- Video Player Theater Column -->
            <div class="hero-media-wrap">
              {featuredHasBoth && (
                <div class="format-toggle-bar" style="margin: 1rem auto;">
                  <button
                    id="heroBtn16x9"
                    class="format-btn active"
                    onclick="window.switchHeroFormat('16x9')"
                  >
                    <span>📺</span>
                    <span data-i18n-hi="16:9 ध्यान जप" data-i18n-en="16:9 Meditative Chanting">16:9 ध्यान जप</span>
                  </button>
                  <button
                    id="heroBtn9x16"
                    class="format-btn"
                    onclick="window.switchHeroFormat('9x16')"
                  >
                    <span>📱</span>
                    <span data-i18n-hi="9:16 लघु दर्शन" data-i18n-en="9:16 Vertical Short">9:16 लघु दर्शन</span>
                  </button>
                </div>
              )}

              {featuredHas9x16 && !featuredHas16x9 && (
                <div class="format-status-badge" style="margin: 1.25rem auto 0.75rem;">
                  <span class="badge-active" data-i18n-hi="📱 लघु दर्शन (Vertical Short)" data-i18n-en="📱 9:16 Vertical Short">📱 लघु दर्शन (Vertical Short)</span>
                  <span class="badge-upcoming" data-i18n-hi="📺 16:9 ध्यान जप: संपादन जारी • Coming Soon" data-i18n-en="📺 16:9 Widescreen Chanting: In Production • Coming Soon">📺 16:9 ध्यान जप: संपादन जारी • Coming Soon</span>
                </div>
              )}

              {featuredHas16x9 && !featuredHas9x16 && (
                <div class="format-status-badge" style="margin: 1.25rem auto 0.75rem;">
                  <span class="badge-active" data-i18n-hi="📺 ध्यान जप (16:9 Widescreen)" data-i18n-en="📺 16:9 Meditative Chanting">📺 ध्यान जप (16:9 Widescreen)</span>
                </div>
              )}

              <!-- 16:9 Landscape Hero Stage (if available) -->
              {featuredHas16x9 && (
                <div class="video-stage-16x9" id="heroView16x9">
                  <div
                    class="lite-embed-facade"
                    id="heroFacade16x9"
                    style={`background-image: url('${featuredRelease.data.hero_image || featuredRelease.data.cover_image || `https://i.ytimg.com/vi/${featuredRelease.data.youtube_16x9_id}/maxresdefault.jpg`}');`}
                    onclick={`window.playHeroVideo('heroView16x9', '${featuredRelease.data.youtube_16x9_id}')`}
                  >
                    <div class="play-button-gold" title="Play 16:9 Chanting Video">
                      <svg viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                  </div>
                </div>
              )}

              <!-- 9:16 Vertical Hero Stage (if available) -->
              {featuredHas9x16 && (
                <div
                  class="video-stage-9x16"
                  id="heroView9x16"
                  style={featuredHasBoth ? 'display: none;' : 'display: block; margin-top: 0.5rem;'}
                >
                  <div
                    class="lite-embed-facade"
                    id="heroFacade9x16"
                    style={`background-image: url('${featuredRelease.data.cover_image || featuredRelease.data.hero_image || `https://i.ytimg.com/vi/${featuredRelease.data.youtube_short_id || featuredRelease.data.youtube_id}/maxresdefault.jpg`}');`}
                    onclick={`window.playHeroVideo('heroView9x16', '${featuredRelease.data.youtube_short_id || featuredRelease.data.youtube_id}')`}
                  >
                    <div class="play-button-gold" title="Play 9:16 Vertical Short">
                      <svg viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                  </div>
                </div>
              )}
            </div>

            <!-- Hero Information Column -->
            <div class="hero-info-wrap">
              <span class="sacred-badge" data-i18n-hi="॥ विशेष प्रस्तुति • Featured Release ॥" data-i18n-en="॥ Featured Offering ॥">॥ विशेष प्रस्तुति • Featured Release ॥</span>
              
              <h1 class="hero-title-hi" lang="hi" id="heroTitle" data-i18n-hi={featuredRelease.data.title_hi} data-i18n-en={featuredRelease.data.title_roman}>
                {featuredRelease.data.title_hi}
              </h1>
              <p class="hero-title-en" lang="en" id="heroSub" data-i18n-hi={featuredRelease.data.title_roman} data-i18n-en={featuredRelease.data.title_hi}>
                {featuredRelease.data.title_roman}
              </p>

              <div class="hero-meta-row">
                <span class="hero-meta-pill" data-i18n-hi={`आराध्य: ${featuredRelease.data.deity}`} data-i18n-en={`Deity: ${featuredRelease.data.deity}`}>आराध्य: {featuredRelease.data.deity}</span>
                <span class="hero-meta-pill" data-i18n-hi={`भाषा: ${featuredRelease.data.dialect}`} data-i18n-en={`Language: ${featuredRelease.data.dialect}`}>भाषा: {featuredRelease.data.dialect}</span>
                {featuredRelease.data.category && (
                  <span class="hero-meta-pill" data-i18n-hi={`विधा: ${featuredRelease.data.category}`} data-i18n-en={`Genre: ${featuredRelease.data.category}`}>विधा: {featuredRelease.data.category}</span>
                )}
              </div>

              <div class="hero-actions">
                <a href={`/${featuredRelease.slug}`} class="btn-gold">
                  <span data-i18n-hi="श्रवण एवं सम्पूर्ण भावार्थ" data-i18n-en="Listen & Read Full Meaning">श्रवण एवं सम्पूर्ण भावार्थ</span>
                  <span>→</span>
                </a>
                <a
                  href={`https://youtube.com/watch?v=${featuredRelease.data.youtube_id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-subtle"
                >
                  <span data-i18n-hi="YouTube पर देखें" data-i18n-en="Watch on YouTube">YouTube पर देखें</span>
                  <span>↗</span>
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Catalog Section -->
  <section class="catalog-section" id="releases">
    <div class="container-wide">
      <div class="catalog-header">
        <div>
          <h2 class="catalog-title-hi" lang="hi" data-i18n-hi="प्रस्तुतियाँ एवं विमर्श" data-i18n-en="Offerings & Discourse">प्रस्तुतियाँ एवं विमर्श</h2>
          <span class="catalog-title-en" lang="en" data-i18n-hi="शाश्वत मंत्र, सांस्कृतिक वृत्तचित्र एवं सभ्यतागत विमर्श" data-i18n-en="Sacred Chants, Cultural Documentaries & Civilizational Discourse">Sacred Releases, Cultural Documentaries & Discourse</span>
        </div>
        <span class="hero-meta-pill" style="font-size: 0.85rem;" data-i18n-hi={`${releases.length} कृतियाँ उपलब्ध`} data-i18n-en={`${releases.length} Releases Available`}>
          {releases.length} कृतियाँ उपलब्ध
        </span>
      </div>

      <!-- Category Pillars Filter -->
      <div class="category-filters">
        <span class="category-pill active" data-i18n-hi="समस्त (All)" data-i18n-en="All">समस्त (All)</span>
        <span class="category-pill" data-i18n-hi="🕉️ शाश्वत मंत्र एवं भजन" data-i18n-en="🕉️ Sacred Chants & Bhajans">🕉️ शाश्वत मंत्र एवं भजन (Sacred Chants)</span>
        <span class="category-pill" data-i18n-hi="📜 सांस्कृतिक वृत्तचित्र" data-i18n-en="📜 Cultural Documentaries">📜 सांस्कृतिक वृत्तचित्र (Cultural Narratives)</span>
        <span class="category-pill" data-i18n-hi="🏛️ समसामयिक विमर्श" data-i18n-en="🏛️ Civilizational Discourse">🏛️ समसामयिक विमर्श (Civilizational Unpacking)</span>
      </div>

      <div class="releases-grid">
        {releases.map((release) => (
          <article class="release-card">
            <a href={`/${release.slug}`} class="card-thumb-wrap">
              <img
                src={release.data.hero_image || release.data.cover_image || `https://i.ytimg.com/vi/${release.data.youtube_id}/hqdefault.jpg`}
                alt={release.data.title_roman}
                class="card-thumb"
                loading="lazy"
              />
            </a>
            
            <div class="card-content">
              <div>
                <h3 class="card-title-hi">
                  <a href={`/${release.slug}`} lang="hi" data-i18n-hi={release.data.title_hi} data-i18n-en={release.data.title_roman}>
                    {release.data.title_hi}
                  </a>
                </h3>
                <p class="card-title-en" lang="en" data-i18n-hi={release.data.title_roman} data-i18n-en={release.data.title_hi}>
                  {release.data.title_roman}
                </p>
              </div>

              <div class="card-meta-row">
                <span class="card-tag">{release.data.deity}</span>
                <span class="card-tag">{release.data.dialect}</span>
                {release.data.category && (
                  <span class="card-tag">{release.data.category}</span>
                )}
                <span class="card-tag">{release.data.year}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Community & Family Section (WhatsApp Channel, YouTube & Instagram) -->
  <section class="community-section" id="community">
    <div class="container">
      <div class="community-card">
        <span class="sacred-badge" style="align-self: center; margin-bottom: 0.8rem;" data-i18n-hi="॥ धूनी परिवार • Authentic Indic Cultural Media ॥" data-i18n-en="॥ Dhuni Collective • Authentic Indic Cultural Media ॥">॥ धूनी परिवार • Authentic Indic Cultural Media ॥</span>
        <h2 class="community-title" lang="hi" data-i18n-hi="धूनी परिवार से जुड़ें" data-i18n-en="Join the Dhuni Collective">धूनी परिवार से जुड़ें</h2>
        <p class="community-sub" data-i18n-hi="पावन वैदिक मंत्रों, पारंपरिक शास्त्रीय भजनों, भारत के इतिहास पर आधारित सांस्कृतिक वृत्तचित्रों, और समसामयिक घटनाओं के गंभीर सभ्यतागत विश्लेषण के लिए हमारे आधिकारिक चैनलों से जुड़ें। बिना किसी भ्रामक शोर के, सीधे आपके फोन पर।" data-i18n-en="Connect directly to our official channels for sacred Vedic chants, traditional classical bhajans, cultural documentaries on Indian civilizational history, and grounded perspectives on contemporary affairs. Direct to your phone, free of sensationalism.">
          पावन वैदिक मंत्रों, पारंपरिक शास्त्रीय भजनों, भारत के इतिहास पर आधारित सांस्कृतिक वृत्तचित्रों, और समसामयिक घटनाओं के गंभीर सभ्यतागत विश्लेषण के लिए हमारे आधिकारिक चैनलों से जुड़ें। बिना किसी भ्रामक शोर के, सीधे आपके फोन पर।
        </p>

        <div class="community-channels-row">
          <a
            href="https://whatsapp.com/channel/example-dhunilive"
            class="btn-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>💬</span>
            <span data-i18n-hi="व्हाट्सएप चैनल से जुड़ें" data-i18n-en="Join WhatsApp Channel">व्हाट्सएप चैनल से जुड़ें</span>
          </a>

          <a
            href="https://youtube.com/@DhuniLive?sub_confirmation=1"
            class="btn-youtube-sub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>▶</span>
            <span data-i18n-hi="YouTube चैनल सब्सक्राइब करें" data-i18n-en="Subscribe on YouTube">YouTube चैनल सब्सक्राइब करें</span>
          </a>

          <a
            href="https://instagram.com/dhunilive.official"
            class="btn-instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>📷</span>
            <span data-i18n-hi="Instagram पर जुड़ें" data-i18n-en="Follow on Instagram">Instagram पर जुड़ें</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <p class="footer-creed" lang="hi" data-i18n-hi="धूनी — शाश्वत स्वर • सांस्कृतिक चेतना • समसामयिक दृष्टि" data-i18n-en="Dhuni — Sacred Acoustics • Cultural Narratives • Civilizational Discourse">
        धूनी — शाश्वत स्वर • सांस्कृतिक चेतना • समसामयिक दृष्टि
      </p>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; max-width: 680px; margin-left: auto; margin-right: auto;" data-i18n-hi="वैदिक मंत्रों और शास्त्रीय ध्वनियों से लेकर, भारत के समृद्ध इतिहास, सांस्कृतिक वृत्तचित्रों और समसामयिक विषयों के गहन विश्लेषण तक — एक मौलिक, सात्त्विक भारतीय मंच।" data-i18n-en="From sacred Vedic chants and acoustic Indian melodies to deep cultural documentaries and insightful civilizational perspectives on contemporary affairs — an authentic, sattvic Indian platform.">
        वैदिक मंत्रों और शास्त्रीय ध्वनियों से लेकर, भारत के समृद्ध इतिहास, सांस्कृतिक वृत्तचित्रों और समसामयिक विषयों के गहन विश्लेषण तक — एक मौलिक, सात्त्विक भारतीय मंच।
      </p>

      <ul class="footer-nav">
        <li><a href="#releases" data-i18n-hi="प्रस्तुतियाँ (Catalog)" data-i18n-en="Offerings (Catalog)">प्रस्तुतियाँ (Catalog)</a></li>
        <li><a href="https://youtube.com/@DhuniLive" target="_blank" rel="noopener noreferrer" data-i18n-hi="YouTube" data-i18n-en="YouTube">YouTube</a></li>
        <li><a href="https://instagram.com/dhunilive.official" target="_blank" rel="noopener noreferrer" data-i18n-hi="Instagram" data-i18n-en="Instagram">Instagram</a></li>
        <li><a href="mailto:hello@dhunilive.com" data-i18n-hi="संपर्क (Email)" data-i18n-en="Contact (Email)">Email / संपर्क</a></li>
      </ul>

      <p style="font-size: 0.8rem; color: #665f57;" data-i18n-hi={`© ${new Date().getFullYear()} धूनी लाइव। सर्वाधिकार सुरक्षित। मौलिक भारतीय सांस्कृतिक एवं ध्वन्यात्मक मंच।`} data-i18n-en={`© ${new Date().getFullYear()} Dhuni Live. All rights reserved. Authentic Indian Cultural & Acoustic Media.`}>
        © {new Date().getFullYear()} Dhuni Live. All rights reserved. Authentic Indian Cultural & Acoustic Media.
      </p>
    </div>
  </footer>

  <!-- Lite Embed Dynamic Script with Auto-Mobile Responsiveness & Language Switcher -->
  <script is:inline>
    window.switchHeroFormat = function switchHeroFormat(format) {
      const btn16 = document.getElementById('heroBtn16x9');
      const btn9 = document.getElementById('heroBtn9x16');
      const view16 = document.getElementById('heroView16x9');
      const view9 = document.getElementById('heroView9x16');

      if (format === '16x9') {
        if (btn16) btn16.classList.add('active');
        if (btn9) btn9.classList.remove('active');
        if (view16) view16.style.display = 'block';
        if (view9) view9.style.display = 'none';
      } else {
        if (btn9) btn9.classList.add('active');
        if (btn16) btn16.classList.remove('active');
        if (view16) view16.style.display = 'none';
        if (view9) view9.style.display = 'block';
      }
    };

    window.playHeroVideo = function playHeroVideo(containerId, videoId) {
      const stage = document.getElementById(containerId);
      if (!stage) return;
      stage.innerHTML = `
        <iframe
          src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1"
          title="Dhuni Live Video Player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          style="width: 100%; height: 100%; border: none; position: absolute; top:0; left:0;"
        ></iframe>
      `;
    };

    // Auto-detect viewport on load: only toggle if both formats exist
    function initHeroFormat() {
      const view16 = document.getElementById('heroView16x9');
      const view9 = document.getElementById('heroView9x16');
      if (view16 && view9) {
        const isMobile = window.innerWidth <= 768;
        window.switchHeroFormat(isMobile ? '9x16' : '16x9');
      } else if (view9) {
        view9.style.display = 'block';
      } else if (view16) {
        view16.style.display = 'block';
      }
    }

    // Discrete Language Switcher
    window.setLanguage = function setLanguage(lang) {
      const btnHi = document.getElementById('btnLangHi');
      const btnEn = document.getElementById('btnLangEn');
      if (lang === 'en') {
        if (btnEn) btnEn.classList.add('active');
        if (btnHi) btnHi.classList.remove('active');
        document.documentElement.lang = 'en';
      } else {
        if (btnHi) btnHi.classList.add('active');
        if (btnEn) btnEn.classList.remove('active');
        document.documentElement.lang = 'hi';
      }
      try {
        localStorage.setItem('dhuni_lang', lang);
      } catch (e) {}

      document.querySelectorAll('[data-i18n-hi]').forEach(el => {
        const text = lang === 'en' ? el.getAttribute('data-i18n-en') : el.getAttribute('data-i18n-hi');
        if (text) el.textContent = text;
      });
    };

    function initLanguage() {
      try {
        const saved = localStorage.getItem('dhuni_lang') || 'hi';
        window.setLanguage(saved);
      } catch (e) {}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initHeroFormat();
        initLanguage();
      });
    } else {
      initHeroFormat();
      initLanguage();
    }
  </script>

</Base>
