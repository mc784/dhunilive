---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Get all non-draft releases, sorted by date descending
const releases = (await getCollection('releases'))
  .filter(release => !release.data.draft)
  .sort((a, b) => b.data.release_date.getTime() - a.data.release_date.getTime());

const featuredRelease = releases.find(r => r.data.featured) || releases[0];

// JSON-LD for MusicGroup
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Dhuni Live',
  alternateName: 'धूनी लाइव',
  genre: 'Indian Classical / Devotional / Bhajan',
  url: 'https://dhunilive.com',
  sameAs: [
    'https://youtube.com/@DhuniLive',
    'https://instagram.com/dhunilive.official',
  ],
  description: 'Sacred Sanskrit shlokas, stutis, and traditional Indian devotional acoustics presented with sattvic reverence and world-class fidelity.',
};

const title = 'धूनी • Dhuni Live — शाश्वत स्वर, सांस्कृतिक चेतना एवं समसामयिक दृष्टि';
const description = 'वैदिक ऋचाओं और शास्त्रीय संगीत से लेकर, भारत के समृद्ध इतिहास, सांस्कृतिक वृत्तचित्रों और समसामयिक विषयों के गहन विश्लेषण तक — धुनि लाइव।';
---

<Base title={title} description={description} jsonLd={jsonLd}>

  <!-- Top Navigation Bar -->
  <nav class="site-nav">
    <div class="container-wide site-nav-inner">
      <a href="/" class="brand-badge">
        <img src="/media/dhuni_logo.png" alt="Dhuni Live Emblem" class="brand-emblem" />
        <div class="brand-text">
          <span class="brand-title-hi">धूनी</span>
          <span class="brand-title-en">Dhuni Live</span>
        </div>
      </a>

      <ul class="nav-links">
        <li><a href="#releases">प्रस्तुतियाँ (Catalog)</a></li>
        <li><a href="https://youtube.com/@DhuniLive" target="_blank" rel="noopener noreferrer">यूट्यूब</a></li>
        <li><a href="https://instagram.com/dhunilive.official" target="_blank" rel="noopener noreferrer">इंस्टाग्राम</a></li>
        <li>
          <a href="#community" class="nav-cta-btn">
            <span>🌿</span>
            <span>व्हाट्सएप चैनल</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Hero Theater (Featured Offering with Responsive Dual-Format Support) -->
  {featuredRelease && (
    <section class="hero-theater">
      <div class="container-wide">
        <div class="hero-card">
          <div class="hero-grid">

            <!-- Video Player Theater Column -->
            <div class="hero-media-wrap">
              <div class="format-toggle-bar" style="margin: 1rem auto;">
                <button
                  id="heroBtn16x9"
                  class="format-btn active"
                  onclick="window.switchHeroFormat('16x9')"
                >
                  <span>📺 16:9 ध्यान जप</span>
                </button>
                <button
                  id="heroBtn9x16"
                  class="format-btn"
                  onclick="window.switchHeroFormat('9x16')"
                >
                  <span>📱 9:16 लघु दर्शन</span>
                </button>
              </div>

              <!-- 16:9 Landscape Hero Stage -->
              <div class="video-stage-16x9" id="heroView16x9">
                <div
                  class="lite-embed-facade"
                  id="heroFacade16x9"
                  style={`background-image: url('${featuredRelease.data.hero_image || featuredRelease.data.cover_image || `https://i.ytimg.com/vi/${featuredRelease.data.youtube_id}/maxresdefault.jpg`}');`}
                  onclick={`window.playHeroVideo('heroView16x9', '${featuredRelease.data.youtube_16x9_id || featuredRelease.data.youtube_id}')`}
                >
                  <div class="play-button-gold" title="Play 16:9 Chanting Video">
                    <svg viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- 9:16 Vertical Hero Stage (Automatically shown on mobile) -->
              <div class="video-stage-9x16" id="heroView9x16" style="display: none;">
                <div
                  class="lite-embed-facade"
                  id="heroFacade9x16"
                  style={`background-image: url('${featuredRelease.data.cover_image || featuredRelease.data.hero_image || `https://i.ytimg.com/vi/${featuredRelease.data.youtube_id}/maxresdefault.jpg`}');`}
                  onclick={`window.playHeroVideo('heroView9x16', '${featuredRelease.data.youtube_short_id || featuredRelease.data.youtube_id}')`}
                >
                  <div class="play-button-gold" title="Play 9:16 Vertical Short">
                    <svg viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>

            <!-- Hero Information Column -->
            <div class="hero-info-wrap">
              <span class="sacred-badge">॥ विशेष प्रस्तुति • Featured Release ॥</span>
              
              <h1 class="hero-title-hi" lang="hi">
                {featuredRelease.data.title_hi}
              </h1>
              <p class="hero-title-en" lang="en">
                {featuredRelease.data.title_roman}
              </p>

              <div class="hero-meta-row">
                <span class="hero-meta-pill">आराध्य: {featuredRelease.data.deity}</span>
                <span class="hero-meta-pill">भाषा: {featuredRelease.data.dialect}</span>
                {featuredRelease.data.raga && (
                  <span class="hero-meta-pill">राग: {featuredRelease.data.raga}</span>
                )}
                {featuredRelease.data.taal && (
                  <span class="hero-meta-pill">ताल: {featuredRelease.data.taal}</span>
                )}
              </div>

              <div class="hero-actions">
                <a href={`/${featuredRelease.slug}`} class="btn-gold">
                  <span>श्रवण एवं सम्पूर्ण भावार्थ</span>
                  <span>→</span>
                </a>
                <a
                  href={`https://youtube.com/watch?v=${featuredRelease.data.youtube_id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-subtle"
                >
                  <span>YouTube पर देखें</span>
                  <span>↗</span>
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Catalog Section -->
  <section class="catalog-section" id="releases">
    <div class="container-wide">
      <div class="catalog-header">
        <div>
          <h2 class="catalog-title-hi" lang="hi">प्रस्तुतियाँ एवं विमर्श</h2>
          <span class="catalog-title-en" lang="en">Sacred Releases, Cultural Documentaries & Discourse</span>
        </div>
        <span class="hero-meta-pill" style="font-size: 0.85rem;">
          {releases.length} कृतियाँ उपलब्ध
        </span>
      </div>

      <!-- Category Pillars Filter -->
      <div class="category-filters">
        <span class="category-pill active">समस्त (All)</span>
        <span class="category-pill">🕉️ शाश्वत मंत्र एवं भजन (Sacred Chants)</span>
        <span class="category-pill">📜 सांस्कृतिक वृत्तचित्र (Cultural Narratives)</span>
        <span class="category-pill">🏛️ समसामयिक विमर्श (Civilizational Unpacking)</span>
      </div>

      <div class="releases-grid">
        {releases.map((release) => (
          <article class="release-card">
            <a href={`/${release.slug}`} class="card-thumb-wrap">
              <img
                src={release.data.cover_image || release.data.hero_image || `https://i.ytimg.com/vi/${release.data.youtube_id}/hqdefault.jpg`}
                alt={release.data.title_roman}
                class="card-thumb"
                loading="lazy"
              />
            </a>
            
            <div class="card-content">
              <div>
                <h3 class="card-title-hi">
                  <a href={`/${release.slug}`} lang="hi">
                    {release.data.title_hi}
                  </a>
                </h3>
                <p class="card-title-en" lang="en">
                  {release.data.title_roman}
                </p>
              </div>

              <div class="card-meta-row">
                <span class="card-tag">{release.data.deity}</span>
                <span class="card-tag">{release.data.dialect}</span>
                {release.data.category && (
                  <span class="card-tag">{release.data.category}</span>
                )}
                <span class="card-tag">{release.data.year}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Community & Sangha Section (WhatsApp Channel, YouTube & Instagram) -->
  <section class="community-section" id="community">
    <div class="container">
      <div class="community-card">
        <span class="sacred-badge" style="align-self: center; margin-bottom: 0.8rem;">॥ धूनी संघ • Sovereign Indic Media ॥</span>
        <h2 class="community-title" lang="hi">धुनि मंच से जुड़ें • Join the Dhuni Collective</h2>
        <p class="community-sub">
          पावन वैदिक मंत्रों, पारंपरिक शास्त्रीय भजनों, भारत के इतिहास पर आधारित सांस्कृतिक वृत्तचित्रों, और समसामयिक घटनाओं के गंभीर सभ्यतागत विश्लेषण के लिए हमारे आधिकारिक चैनलों से जुड़ें। बिना किसी भ्रामक शोर के, सीधे आपके फोन पर।
        </p>

        <div class="community-channels-row">
          <a
            href="https://whatsapp.com/channel/example-dhunilive"
            class="btn-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>💬</span>
            <span>व्हाट्सएप चैनल से जुड़ें</span>
          </a>

          <a
            href="https://youtube.com/@DhuniLive?sub_confirmation=1"
            class="btn-youtube-sub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>▶</span>
            <span>YouTube चैनल</span>
          </a>

          <a
            href="https://instagram.com/dhunilive.official"
            class="btn-instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>📷</span>
            <span>Instagram फॉलो करें</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <p class="footer-creed" lang="hi">
        धूनी — शाश्वत स्वर • सांस्कृतिक चेतना • समसामयिक दृष्टि
      </p>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; max-width: 680px; margin-left: auto; margin-right: auto;">
        वैदिक मंत्रों और शास्त्रीय ध्वनियों से लेकर, भारत के समृद्ध इतिहास, सांस्कृतिक वृत्तचित्रों और समसामयिक विषयों के गहन विश्लेषण तक — एक संप्रभु, सात्त्विक भारतीय मंच।
      </p>

      <ul class="footer-nav">
        <li><a href="#releases">प्रस्तुतियाँ (Catalog)</a></li>
        <li><a href="https://youtube.com/@DhuniLive" target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a href="https://instagram.com/dhunilive.official" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="mailto:hello@dhunilive.com">Email / संपर्क</a></li>
      </ul>

      <p style="font-size: 0.8rem; color: #665f57;">
        © {new Date().getFullYear()} Dhuni Live. All rights reserved. Sovereign Indian Media Architecture.
      </p>
    </div>
  </footer>

  <!-- Lite Embed Dynamic Script with Auto-Mobile Responsiveness -->
  <script is:inline>
    window.switchHeroFormat = function switchHeroFormat(format) {
      const btn16 = document.getElementById('heroBtn16x9');
      const btn9 = document.getElementById('heroBtn9x16');
      const view16 = document.getElementById('heroView16x9');
      const view9 = document.getElementById('heroView9x16');

      if (format === '16x9') {
        if (btn16) btn16.classList.add('active');
        if (btn9) btn9.classList.remove('active');
        if (view16) view16.style.display = 'block';
        if (view9) view9.style.display = 'none';
      } else {
        if (btn9) btn9.classList.add('active');
        if (btn16) btn16.classList.remove('active');
        if (view16) view16.style.display = 'none';
        if (view9) view9.style.display = 'block';
      }
    };

    window.playHeroVideo = function playHeroVideo(containerId, videoId) {
      const stage = document.getElementById(containerId);
      if (!stage) return;
      stage.innerHTML = `
        <iframe
          src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1"
          title="Dhuni Live Video Player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          style="width: 100%; height: 100%; border: none; position: absolute; top:0; left:0;"
        ></iframe>
      `;
    };

    // Auto-detect viewport on load: on phones (<= 768px), default to 9:16 vertical short!
    function initHeroFormat() {
      const isMobile = window.innerWidth <= 768;
      window.switchHeroFormat(isMobile ? '9x16' : '16x9');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroFormat);
    } else {
      initHeroFormat();
    }
  </script>

</Base>
