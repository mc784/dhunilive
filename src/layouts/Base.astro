---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  ogImage?: string;
  jsonLd?: object;
}

const {
  title,
  description,
  lang = 'hi',
  ogImage = '/og-image.jpg',
  jsonLd,
} = Astro.props;

const siteUrl = 'https://dhunilive.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl)} />
    <meta property="og:locale" content="hi_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%231a1612'/%3E%3Ctext x='50' y='65' font-family='serif' font-size='60' fill='%23d4663a' text-anchor='middle'%3Eध%3C/text%3E%3C/svg%3E" />

    <!-- TEMPORARY: Google Fonts fallback for development
         REMOVE BEFORE PRODUCTION - Replace with self-hosted subsetted fonts
         See public/fonts/README.md for subsetting instructions -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet">

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <slot />

    <!-- Floating Sticky WhatsApp Channel Banner -->
    <aside class="floating-wa-bar" id="floatingWaBar">
      <div class="floating-wa-content">
        <span class="floating-wa-icon">🌿</span>
        <span class="floating-wa-text" data-i18n-hi="दैनिक प्रातः दर्शन एवं पावन श्लोक सीधे WhatsApp पर प्राप्त करें" data-i18n-en="Receive Daily Morning Darshan & Sacred Shlokas on WhatsApp">
          दैनिक प्रातः दर्शन एवं पावन श्लोक सीधे WhatsApp पर प्राप्त करें
        </span>
      </div>
      <a
        href="https://whatsapp.com/channel/0029VbDdbaFIN9iua995UG3n"
        class="floating-wa-btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>जुड़ें • Join →</span>
      </a>
      <button class="floating-wa-close" onclick="document.getElementById('floatingWaBar').style.display='none'" aria-label="Close">×</button>
    </aside>

    <style is:inline>
      .floating-wa-bar {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 14px;
        background: rgba(18, 14, 22, 0.94);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(212, 175, 55, 0.45);
        border-radius: 9999px;
        padding: 8px 16px 8px 20px;
        box-shadow: 0 10px 32px rgba(0, 0, 0, 0.6);
        animation: floatIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        max-width: 92vw;
      }
      @keyframes floatIn {
        from { opacity: 0; transform: translate(-50%, 20px); }
        to { opacity: 1; transform: translate(-50%, 0); }
      }
      .floating-wa-content {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.92rem;
        color: #f2ede4;
        white-space: nowrap;
      }
      .floating-wa-btn {
        background: linear-gradient(135deg, #25D366, #128C7E);
        color: #ffffff !important;
        font-weight: 600;
        font-size: 0.88rem;
        padding: 6px 14px;
        border-radius: 9999px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: transform 0.2s ease, filter 0.2s ease;
        white-space: nowrap;
      }
      .floating-wa-btn:hover {
        transform: scale(1.04);
        filter: brightness(1.1);
      }
      .floating-wa-close {
        background: none;
        border: none;
        color: #8c827a;
        font-size: 1.2rem;
        line-height: 1;
        cursor: pointer;
        padding: 0 4px;
        transition: color 0.2s;
      }
      .floating-wa-close:hover {
        color: #ffffff;
      }
      @media (max-width: 640px) {
        .floating-wa-bar {
          bottom: 12px;
          padding: 6px 12px 6px 14px;
          gap: 10px;
        }
        .floating-wa-text {
          font-size: 0.78rem;
        }
        .floating-wa-btn {
          font-size: 0.76rem;
          padding: 5px 10px;
        }
      }
    </style>
  </body>
</html>
